# Copy to .env only if you need to change a default.
# The app runs with no .env file.

HOST=0.0.0.0
PORT=8080
OPEN_BROWSER=1

# Seconds to wait for the Autobahn API.
AUTOBAHN_TIMEOUT=20

# Keep this on. Set to 0 only on a network that breaks certificate checks.
AUTOBAHN_SSL_VERIFY=1

# Set to 1 to print a public link a friend can open while this computer stays on.
ON_AIR=0

# AUTOBAHN_BASE_URL=https://verkehr.autobahn.de/o/autobahn
